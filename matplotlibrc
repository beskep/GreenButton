axes.prop_cycle: cycler('color', ['4477AA', 'EE6677', '228833', 'CCBB44', '66CCEE', 'AA3377', 'BBBBBB', '000000'])

figure.constrained_layout.use: True

figure.dpi:     150
savefig.dpi:    300
figure.figsize: 6.2992, 3.5433

pdf.fonttype: 42

axes.edgecolor:     0.2
axes.grid:          True
axes.axisbelow:     True  # draw axis gridlines and ticks below patches
axes.titlelocation: left
axes.titleweight:   500

grid.color: "#cccccc"
grid.alpha: 0.6

xtick.top:           True
xtick.minor.visible: True
xtick.color:         0.2
xtick.labelcolor:    0
xtick.direction:     in

ytick.right:         True
ytick.minor.visible: True
ytick.color:         0.2
ytick.labelcolor:    0
ytick.direction:     in

font.family:     sans-serif
font.serif:      Noto Serif KR, Source Han Serif KR, DejaVu Serif
font.sans-serif: Noto Sans KR, Source Han Sans KR, DejaVu Sans

mathtext.fontset: cm  # dejavusans, cm, stix, stixsans, custom
